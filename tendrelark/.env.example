# Copy to .env for local work. In production set these on the host, never commit them.

NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000

# Where the SQLite database lives. In production this MUST point at a persistent
# volume (for example /data/tendrelark.db). The app refuses to start in production
# without it, because an ephemeral disk silently loses every stored TED notice.
DATABASE_PATH=./data/tendrelark.db

# Used to sign form tokens and unsubscribe links. Long random string, at least 32 chars.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=change-me-change-me-change-me-change-me

# Number of reverse proxy hops in front of the app (needed for correct client IPs).
TRUST_PROXY=0

# Admin area (/admin). Leave ADMIN_PASSWORD empty to switch the admin area off.
ADMIN_USER=editor
ADMIN_PASSWORD=

# Contact details shown on the site and used as the reply address.
CONTACT_EMAIL=support@tendrelark.eu
LEGAL_ENTITY_NAME=Tendrelark
LEGAL_ENTITY_DETAILS=

# Email. Without SMTP_URL, emails are printed to the console and logged, not sent.
#   SMTP_URL=smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM=Tendrelark <support@tendrelark.eu>

# TED (Tenders Electronic Daily) ingestion.
TED_API_URL=https://api.ted.europa.eu/v3/notices/search
TED_COUNTRIES=PRT,LUX,BEL
# Optional: override the fields requested from the TED API (comma separated).
TED_FIELDS=
# How many days back each run re-reads, so late or corrected notices are caught.
TED_OVERLAP_DAYS=3
# First run: how far back to start when the database is empty.
TED_BACKFILL_DAYS=30

# Background jobs inside the web process: the daily TED import and the source checks.
ENABLE_SCHEDULER=false
SOURCE_CHECK_INTERVAL_MINUTES=1440

# Daily TED import. Runs once a day at this UTC time. If the run does not complete (TED errors,
# an empty answer, another run in progress) it is retried every TED_RETRY_INTERVAL_MINUTES for up
# to TED_RETRY_WINDOW_MINUTES. Afterwards the log of every attempt is emailed to TED_REPORT_EMAIL.
TED_DAILY_AT_UTC=06:00
TED_RETRY_INTERVAL_MINUTES=10
TED_RETRY_WINDOW_MINUTES=60
TED_REPORT_EMAIL=support@tendrelark.eu

# Nightly database backups. Leave BACKUP_DIR empty to switch them off. Each backup is verified by restoring it.
# Point BACKUP_DIR at a folder that is copied off the server (see docs/backups.md). The passphrase encrypts
# the files, because they contain subscriber emails. Keep it somewhere safe: without it a backup cannot be opened.
BACKUP_DIR=
BACKUP_PASSPHRASE=
BACKUP_KEEP_DAYS=14
BACKUP_AT_UTC=03:00

# Operational alerts (server errors, failed backups, crashes) go to ALERT_EMAIL, at most one of each kind per
# ALERT_THROTTLE_MINUTES. Defaults to TED_REPORT_EMAIL. Needs SMTP_URL like every other email.
ALERT_EMAIL=support@tendrelark.eu
ALERT_THROTTLE_MINUTES=15
EMAIL_LOG_RETENTION_DAYS=90
