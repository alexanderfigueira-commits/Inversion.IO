# Copy to production.env (same folder) and fill in. Do not commit production.env, and do not use quotes.
# Everything not listed here has a safe default. See ../.env.example for all settings.

SITE_URL=https://www.tendrelark.eu

# Generate with:  openssl rand -hex 32
APP_SECRET=

# Admin area at /admin. Pick a long password.
ADMIN_USER=editor
ADMIN_PASSWORD=

# Build the SMTP_URL with:  npm run mail:url   (see docs/email.md)
SMTP_URL=
MAIL_FROM=Tendrelark <support@tendrelark.eu>
CONTACT_EMAIL=support@tendrelark.eu
ALERT_EMAIL=support@tendrelark.eu
TED_REPORT_EMAIL=support@tendrelark.eu

# Shown in the footer and on the privacy page. Fill in once known.
LEGAL_ENTITY_NAME=Tendrelark
LEGAL_ENTITY_DETAILS=

# Encrypts the nightly backups (at least 12 characters). Keep a copy in a password manager.
BACKUP_PASSPHRASE=

TED_DAILY_AT_UTC=06:00
