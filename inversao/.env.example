# Copia para .env.local para desenvolvimento. Nunca meter chaves reais em ficheiros que vão para o git.

# Chave da Anthropic. Em produção vem do Secret Manager (fase 6), nunca deste ficheiro.
ANTHROPIC_API_KEY=

# Modelo (por defeito claude-sonnet-5-5)
# MODELO_ANTHROPIC=claude-sonnet-5-5

# Respostas simuladas, só em desenvolvimento. Não funciona em produção.
MOCK_IA=1

# Controlo de custos
# MAX_CARACTERES=4000
# LIMITE_HORA=10
# LIMITE_DIA=30
# LIMITE_GLOBAL_DIA=300
# TOKENS_SEM_DEBATE=3000
# TOKENS_COM_DEBATE=5500

# Pasta da skill (por defeito ./skill)
# SKILL_DIR=./skill
